{
  "name": "@chat-scroll/core",
  "version": "0.1.0",
  "description": "Headless scroll management for chat UIs — framework-agnostic core",
  "keywords": [
    "ai-chat",
    "chat",
    "headless",
    "pin-to-top",
    "scroll",
    "stick-to-bottom",
    "streaming"
  ],
  "homepage": "https://flintc.github.io/chat-scroll/",
  "bugs": "https://github.com/flintc/chat-scroll/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flintc/chat-scroll.git",
    "directory": "packages/chat-scroll-core"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  }
}
