{
  "name": "@chat-scroll/solid",
  "version": "0.1.0",
  "description": "Solid adapter for @chat-scroll/core",
  "homepage": "https://flintc.github.io/chat-scroll/",
  "bugs": "https://github.com/flintc/chat-scroll/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flintc/chat-scroll.git",
    "directory": "packages/solid-chat-scroll"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@chat-scroll/core": "workspace:*"
  },
  "devDependencies": {
    "@solidjs/testing-library": "^0.8.10",
    "solid-js": "^1.9.4"
  },
  "peerDependencies": {
    "solid-js": "^1.8.0"
  }
}
