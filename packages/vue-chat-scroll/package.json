{
  "name": "@chat-scroll/vue",
  "version": "0.1.0",
  "description": "Vue adapter for @chat-scroll/core",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "dependencies": {
    "@chat-scroll/core": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.6.0",
    "typescript-eslint": "^8.62.1",
    "vue": "^3.5.13"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flintc/chat-scroll.git",
    "directory": "packages/vue-chat-scroll"
  },
  "homepage": "https://flintc.github.io/chat-scroll/",
  "bugs": "https://github.com/flintc/chat-scroll/issues"
}
