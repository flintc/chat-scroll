{
  "name": "@chat-scroll/vue",
  "version": "0.1.0",
  "description": "Vue adapter for @chat-scroll/core",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "dependencies": {
    "@chat-scroll/core": "workspace:*"
  },
  "devDependencies": {
    "@vue/test-utils": "^2.4.6",
    "vue": "^3.5.13"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
