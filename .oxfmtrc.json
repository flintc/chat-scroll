{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "semi": false,
  "printWidth": 80,
  "tabWidth": 2,
  "trailingComma": "all",
  "arrowParens": "always",
  "ignorePatterns": [
    "**/dist",
    "**/node_modules",
    "**/*.md",
    "docs/.vitepress/cache",
    "e2e/playwright-report",
    "e2e/test-results",
    "e2e/videos",
    "pnpm-lock.yaml"
  ]
}
